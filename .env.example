# Copy to .env and replace every value. .env is git-ignored; never commit it.
# These are synthetic development placeholders, not deployable credentials.

# --- Tenant credentials -----------------------------------------------------
# The X-API-Key header is matched against these; the tenant is then resolved
# server-side. A request body can never choose its own tenant.
TENANT_A_API_KEY=dev-a-change-me-0000000000
TENANT_B_API_KEY=dev-b-change-me-1111111111

# --- LLM provider -----------------------------------------------------------
# ollama  -> local inference on this machine (the CSPRO assessment setting)
# openai  -> any OpenAI-compatible HTTP endpoint (development convenience only)
# There is no automatic failover between them. If the selected provider is
# down, /ask returns HTTP 503.
LLM_PROVIDER=ollama
LLM_BASE_URL=http://localhost:11434
LLM_MODEL=qwen3:0.6b
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=60
LLM_MAX_OUTPUT_TOKENS=400

# Example development override (remote inference -- NOT local):
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
# LLM_API_KEY=sk-...

# --- Storage and retrieval --------------------------------------------------
DB_PATH=data/aegisrag.sqlite3
RECORDS_SEED_PATH=data/synthetic_records.json
RETRIEVAL_MIN_SCORE=0.35
GROUNDING_MIN_SUPPORT=0.35
EXCERPT_MAX_CHARS=320

# Set to false only to demonstrate that the deeper defences hold without the
# ingest-time injection scanner (see tests/test_security.py).
QUARANTINE_INJECTED_RECORDS=true

LOG_LEVEL=INFO
