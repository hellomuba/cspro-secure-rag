# Keep the build context small and keep secrets out of the image.
.git/
.gitignore
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
htmlcov/

# Secrets: never copy a real .env into an image layer.
.env
.env.*
!.env.example

# Local state, regenerated from data/synthetic_records.json at startup.
data/*.sqlite3
data/*.sqlite3-shm
data/*.sqlite3-wal

# The API image runs neither the fine-tuning experiment nor the optional UI.
finetuning/
requirements-finetuning.txt
ui/
requirements-ui.txt

# Docs and scratch files
docs/
tasks/
README.md
*.md
!data/*.md
Dockerfile
compose.yaml
.dockerignore
